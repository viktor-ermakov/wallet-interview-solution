# Aplicação
DATABASE_URL=postgresql+asyncpg://wallet:wallet@db:5432/wallet
SECRET_KEY=troque-por-uma-string-hex-aleatoria-de-256-bits
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gateway — defina GATEWAY_PROVIDER como "stripe" ou "mercadopago" e preencha o bloco correspondente
GATEWAY_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Mercado Pago (alternativa)
# MERCADO_PAGO_ACCESS_TOKEN=

# LLM — provider do agente de IA
LLM_PROVIDER=anthropic        # anthropic | openai
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=sk-ant-
